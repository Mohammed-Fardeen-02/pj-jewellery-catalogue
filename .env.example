# =============================================================================
# PJ Jewellery Catalogue — Monorepo Environment Variables Example
# =============================================================================
# This file provides a centralized overview of all environment variables used
# across the Backend (FastAPI) and Frontend (Next.js) applications.
#
# Backend: Copy to backend/.env
# Frontend: Copy to frontend/.env.local
# =============================================================================

# =============================================================================
# 1. BACKEND SERVICE (.env in backend/)
# =============================================================================

# Application Core
APP_NAME="PJ Jewellery Catalogue API"
APP_ENV=development                            # development | staging | production | test
API_V1_PREFIX=/api/v1
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database Persistence
# For Docker / Local PostgreSQL 15+:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pj_jewellery_dev
# For Zero-Configuration Local SQLite:
# DATABASE_URL=sqlite+aiosqlite:///./dev_local.db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_PRE_PING=true

# Security & Authentication (Argon2 + PyJWT)
# Minimum 32 characters in staging/production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Super Administrator Bootstrap Credentials
# (Consumed by python scripts/seed_admin.py to seed or update the super_admin user)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_FULL_NAME=

# Cloudinary Media Storage (Product Images & Videos)
# Obtain these from your Cloudinary Dashboard: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=pj_jewellery

# CORS & Allowed Origins
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Logging Level
LOG_LEVEL=INFO                                 # DEBUG | INFO | WARNING | ERROR | CRITICAL

# =============================================================================
# 2. FRONTEND SERVICE (.env.local in frontend/)
# =============================================================================
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_V1_PREFIX=/api/v1
NEXT_PUBLIC_APP_NAME="PJ Jewellery Catalogue"
