# =============================================================================
# PJ Jewellery Catalogue — Backend Environment Configuration Template
# Copy this file to .env and configure the variables for your setup:
#   cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Application & Server Configuration
# -----------------------------------------------------------------------------
APP_NAME="PJ Jewellery Catalogue API"
APP_ENV="development" # Options: development | staging | production | test
API_V1_PREFIX="/api/v1"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# -----------------------------------------------------------------------------
# 2. Database Persistence (Async PostgreSQL / SQLite)
# -----------------------------------------------------------------------------
# For Docker / Local PostgreSQL (Default):
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/pj_jewellery_dev"

# For Zero-Config Local SQLite (Alternative for instant local execution without Docker):
# DATABASE_URL="sqlite+aiosqlite:///./dev_local.db"

DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_PRE_PING=true

# -----------------------------------------------------------------------------
# 3. Security, Cryptography & JWT Tokens (Argon2 + PyJWT)
# -----------------------------------------------------------------------------
# Cryptographic secret for signing JWT access and refresh tokens.
# Minimum 32 characters in staging/production. Generate using: openssl rand -hex 32
JWT_SECRET_KEY=""
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# 4. Super Administrator Initial Bootstrap Credentials
# -----------------------------------------------------------------------------
# Read by `python scripts/seed_admin.py` to create or update the super_admin account.
# Password must be at least 10 characters long (hashed with Argon2 via pwdlib).
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""
SUPERADMIN_FULL_NAME=""

# -----------------------------------------------------------------------------
# 5. Cloudinary Media Storage (Product Images & Videos)
# -----------------------------------------------------------------------------
# Obtain these credentials from your Cloudinary Console (https://console.cloudinary.com)
# If left empty, the application runs in local mock mode without network errors.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="pj_jewellery"

# -----------------------------------------------------------------------------
# 6. CORS & Frontend Integration
# -----------------------------------------------------------------------------
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# -----------------------------------------------------------------------------
# 7. Logging & Diagnostics
# -----------------------------------------------------------------------------
LOG_LEVEL="INFO" # Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
