# Application Configuration
APP_NAME="PJ Jewellery Catalogue API"
APP_ENV="development" # development | staging | production | test
API_V1_PREFIX="/api/v1"
DEBUG=true

# Server Configuration
HOST="0.0.0.0"
PORT=8000

# Database Configuration
# Default: Zero-configuration local async SQLite (starts instantly without installing PostgreSQL)
DATABASE_URL="sqlite+aiosqlite:///./dev_local.db"
# For Docker or local PostgreSQL 15+:
# DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/pj_jewellery_dev"
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_PRE_PING=true

# Security & Authentication (Argon2 + PyJWT)
# Generate a secure 32+ char key using: openssl rand -hex 32
JWT_SECRET_KEY="replace-this-with-a-secure-random-secret-key-at-least-32-chars-long"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS & Frontend Integration
# Explicit origins only - no wildcards with credentials
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Logging
LOG_LEVEL="INFO" # DEBUG | INFO | WARNING | ERROR | CRITICAL
