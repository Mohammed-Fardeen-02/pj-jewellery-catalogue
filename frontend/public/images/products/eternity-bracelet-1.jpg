<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 1000" width="100%" height="100%">
  <defs>
    <radialGradient id="brcGrad" cx="50%" cy="40%" r="65%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="65%" stop-color="#F9F5EE"/>
      <stop offset="100%" stop-color="#EBE3D4"/>
    </radialGradient>
    <linearGradient id="platGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#F3F4F6"/>
      <stop offset="50%" stop-color="#D1D5DB"/>
      <stop offset="100%" stop-color="#9CA3AF"/>
    </linearGradient>
  </defs>
  <rect width="100%" height="100%" fill="url(#brcGrad)"/>
  <ellipse cx="400" cy="740" rx="260" ry="30" fill="#D3C7B5" opacity="0.3"/>

  <!-- Articulated Tennis Bracelet Ellipse -->
  <ellipse cx="400" cy="560" rx="230" ry="150" fill="none" stroke="url(#platGrad)" stroke-width="14"/>

  <!-- Diamond Stones along circumference -->
  <g fill="#FFFFFF" stroke="#9CA3AF" stroke-width="1.5">
    <circle cx="170" cy="560" r="8"/>
    <circle cx="190" cy="500" r="8"/>
    <circle cx="230" cy="450" r="8"/>
    <circle cx="290" cy="420" r="8"/>
    <circle cx="360" cy="410" r="8"/>
    <circle cx="440" cy="410" r="8"/>
    <circle cx="510" cy="420" r="8"/>
    <circle cx="570" cy="450" r="8"/>
    <circle cx="610" cy="500" r="8"/>
    <circle cx="630" cy="560" r="8"/>
    <circle cx="610" cy="620" r="8"/>
    <circle cx="570" cy="670" r="8"/>
    <circle cx="510" cy="700" r="8"/>
    <circle cx="440" cy="710" r="8"/>
    <circle cx="360" cy="710" r="8"/>
    <circle cx="290" cy="700" r="8"/>
    <circle cx="230" cy="670" r="8"/>
    <circle cx="190" cy="620" r="8"/>
  </g>
</svg>
