<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 1000" width="100%" height="100%">
  <defs>
    <radialGradient id="neckGrad" cx="50%" cy="30%" r="70%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="65%" stop-color="#FAF5EE"/>
      <stop offset="100%" stop-color="#EBE2D3"/>
    </radialGradient>
    <linearGradient id="goldChain" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#ECD4A8"/>
      <stop offset="50%" stop-color="#B08D57"/>
      <stop offset="100%" stop-color="#8C6E3D"/>
    </linearGradient>
  </defs>
  <rect width="100%" height="100%" fill="url(#neckGrad)"/>
  
  <!-- Chain Arc -->
  <path d="M 220 180 C 220 520, 320 620, 400 660 C 480 620, 580 520, 580 180" fill="none" stroke="url(#goldChain)" stroke-width="4.5" stroke-dasharray="8,3"/>
  <path d="M 235 180 C 235 480, 330 570, 400 610 C 470 570, 565 480, 565 180" fill="none" stroke="#FFFFFF" stroke-width="1.5" opacity="0.6"/>

  <!-- Celestial Pendant Drop -->
  <g transform="translate(400, 660)">
    <circle cx="0" cy="0" r="7" fill="#B08D57"/>
    <line x1="0" y1="7" x2="0" y2="40" stroke="#B08D57" stroke-width="3"/>
    <circle cx="0" cy="55" r="28" fill="#FFFFFF" stroke="#B08D57" stroke-width="3"/>
    <polygon points="0,35 14,50 35,55 14,60 0,75 -14,60 -35,55 -14,50" fill="#B08D57" opacity="0.85"/>
    <circle cx="0" cy="55" r="8" fill="#FFFFFF"/>
    <!-- Radiance -->
    <circle cx="0" cy="55" r="4" fill="#E0F2FE"/>
  </g>
</svg>
