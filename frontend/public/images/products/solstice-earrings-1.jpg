<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 1000" width="100%" height="100%">
  <defs>
    <radialGradient id="earGrad" cx="50%" cy="30%" r="70%">
      <stop offset="0%" stop-color="#FFFFFF"/>
      <stop offset="65%" stop-color="#F8F3EC"/>
      <stop offset="100%" stop-color="#E8DEC8"/>
    </radialGradient>
    <linearGradient id="goldEar" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#EBD5AC"/>
      <stop offset="50%" stop-color="#B08D57"/>
      <stop offset="100%" stop-color="#8C6E3D"/>
    </linearGradient>
  </defs>
  <rect width="100%" height="100%" fill="url(#earGrad)"/>

  <!-- Left Earring -->
  <g transform="translate(320, 360)">
    <circle cx="0" cy="0" r="10" fill="url(#goldEar)"/>
    <circle cx="0" cy="0" r="4" fill="#FFFFFF"/>
    <path d="M 0 10 L 0 50 L -18 110 L 0 160 L 18 110 Z" fill="none" stroke="url(#goldEar)" stroke-width="4"/>
    <circle cx="0" cy="160" r="12" fill="#FFFFFF" stroke="url(#goldEar)" stroke-width="3"/>
    <polygon points="0,70 12,110 0,140 -12,110" fill="#E0F2FE" stroke="#B08D57" stroke-width="1.5"/>
  </g>

  <!-- Right Earring -->
  <g transform="translate(480, 360)">
    <circle cx="0" cy="0" r="10" fill="url(#goldEar)"/>
    <circle cx="0" cy="0" r="4" fill="#FFFFFF"/>
    <path d="M 0 10 L 0 50 L -18 110 L 0 160 L 18 110 Z" fill="none" stroke="url(#goldEar)" stroke-width="4"/>
    <circle cx="0" cy="160" r="12" fill="#FFFFFF" stroke="url(#goldEar)" stroke-width="3"/>
    <polygon points="0,70 12,110 0,140 -12,110" fill="#E0F2FE" stroke="#B08D57" stroke-width="1.5"/>
  </g>
</svg>
